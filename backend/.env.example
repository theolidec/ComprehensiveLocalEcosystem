# Server Configuration
PORT=3001
HTTPS_PORT=3443
NODE_ENV=development

# SSL/HTTPS Configuration
SSL_CERT_PATH=certs/server.crt
SSL_KEY_PATH=certs/server.key
USE_HTTPS=true

# JWT Configuration (Generate strong secrets for production)
JWT_SECRET=your_super_secret_jwt_key_here_replace_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_replace_in_production

# Token Expiration Configuration
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Configuration. REQUIRED in production — the server refuses to start
# without it when NODE_ENV=production (prevents accidental localhost fallback).
FRONTEND_URL=http://localhost:3000

# Cookie security. Auth cookies are issued with the Secure flag (HTTPS-only)
# unless this is set to "true". Use only for local plain-HTTP development.
ALLOW_INSECURE_COOKIES=false

# Trust proxy. Defaults to internal-only IP ranges (loopback, linklocal, uniquelocal)
# so a public-facing client cannot spoof X-Forwarded-For. Override with a hop count
# (e.g. "1") or a comma-separated CIDR list when behind a known proxy chain.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/full-system-architecture

# Security Configuration
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=logs/

# Session Configuration
SESSION_SECRET=your_session_secret_here_replace_in_production

# Email Configuration (for future password-reset email delivery — not yet wired up)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend Configuration (for development)
REACT_APP_API_URL=http://localhost:3001

# Password Manager Configuration (REQUIRED — Generate a strong random key, 32+ chars)
# WARNING: rotating this key without re-encrypting every stored password and payment
# card will make them permanently undecryptable.
PASSWORD_MASTER_KEY=your_secure_master_key_for_password_encryption

# File Storage Configuration
UPLOAD_DIR=uploads/files
MAX_FILE_SIZE=524288000
MAX_STORAGE_BYTES=10737418240
